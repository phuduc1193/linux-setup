#!/usr/bin/env python3
"""Silent mode: power-saver + all RGB off via the OpenRGB CLI directly
(local hardware access, no server or Ryoku needed).

RAM detection fix: add `acpi_enforce_resources=lax` to the kernel cmdline,
otherwise the FCH SMBus is disabled and Corsair Vengeance RGB DDR5 sticks
(0x19 / 0x1B on the PIIX4 SMBus) won't show up in OpenRGB.
"""
import shutil
import subprocess
import sys
from pathlib import Path

OPENRGB = shutil.which("openrgb") or "/usr/bin/openrgb"
NOTIFY = shutil.which("notify-send") or "/usr/bin/notify-send"
POWER = shutil.which("powerprofilesctl") or "/usr/bin/powerprofilesctl"

STATE = Path.home() / ".local/state/silent-mode"
ON = STATE / "on"
PROFILES = Path.home() / ".config/OpenRGB/profiles"


def run(*args):
    r = subprocess.run([OPENRGB, *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"openrgb {' '.join(args)} failed: {r.stderr.strip()}")
    return r


def notify(title, body):
    if Path(NOTIFY).exists():
        subprocess.run([NOTIFY, title, body], capture_output=True)


def ensure_profiles():
    """Create normal + silent OpenRGB profiles if missing."""
    PROFILES.mkdir(parents=True, exist_ok=True)
    if (PROFILES / "normal.json").exists() and (PROFILES / "silent.json").exists():
        return
    # Save current look as 'normal', then turn all LEDs black and save as 'silent'.
    run("--save-profile", "normal")
    run("--color", "000000")
    run("--save-profile", "silent")
    run("--profile", "normal")


def set_cpu(profile):
    """Switch powerprofile if available; silently no-op otherwise."""
    if Path(POWER).exists():
        subprocess.run([POWER, "set", profile], capture_output=True)


def main():
    STATE.mkdir(parents=True, exist_ok=True)
    ensure_profiles()

    if ON.exists():
        run("--profile", "normal")
        set_cpu("balanced")
        ON.unlink()
        notify("Silent mode OFF", "RGB restored, balanced power")
    else:
        # Refresh normal so we restore whatever the user currently has.
        run("--save-profile", "normal")
        run("--profile", "silent")
        set_cpu("power-saver")
        ON.write_text("")
        notify("Silent mode ON", "Lights out, power-saver")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("--init", "init"):
        ensure_profiles()
        notify("Silent mode", "Profiles initialized")
    else:
        main()
